{
  "name": "ply-ui",
  "version": "0.2.1",
  "description": "Roblox-inspired React components with connected selection, motion, and accessible interactions.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "components",
    "lib",
    "styles",
    "styles.css",
    "README.md",
    "styles.css.d.ts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "cli",
    "templates"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./styles.css": "./styles.css",
    "./fonts.css": "./styles/fonts.css",
    "./theme.css": "./styles/theme.css",
    "./tokens.css": "./styles/tokens.css",
    "./motion.css": "./styles/motion.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baboribo/roblox-base-ui.git"
  },
  "homepage": "https://roblox-base-ui.vercel.app/docs",
  "author": "baboribo",
  "bin": {
    "ply-ui": "./cli/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
